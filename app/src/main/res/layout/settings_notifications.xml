<merge xmlns:android="http://schemas.android.com/apk/res/android">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/card">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Notifications" android:textSize="20sp" android:textColor="#294B37" android:textStyle="bold" android:layout_marginBottom="6dp"/>
<Switch android:id="@+id/sms_alerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:text="SMS alerts" android:textStyle="bold" android:textColor="#213E30" android:switchPadding="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Critical alerts by text message" android:textSize="13sp" android:textColor="#294B37" />
<Switch android:id="@+id/email_digest" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:text="Email digest" android:textStyle="bold" android:textColor="#213E30" android:switchPadding="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Daily summary of farm conditions" android:textSize="13sp" android:textColor="#294B37" />
<Switch android:id="@+id/offline_alerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:text="Offline device alerts" android:textStyle="bold" android:textColor="#213E30" android:switchPadding="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="When a sensor stops reporting" android:textSize="13sp" android:textColor="#294B37" />
<Switch android:id="@+id/low_battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:text="Low battery warnings" android:textStyle="bold" android:textColor="#213E30" android:switchPadding="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="When a sensor falls below 15%" android:textSize="13sp" android:textColor="#294B37" />
</LinearLayout>
</merge>
