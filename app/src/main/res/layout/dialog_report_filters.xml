<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Target pens" android:labelFor="@+id/filter_pen" android:textColor="#183A2B" android:textSize="14sp"/>
        <Spinner android:id="@+id/filter_pen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Sensor" android:labelFor="@+id/filter_sensor" android:textColor="#183A2B" android:textSize="14sp"/>
        <Spinner android:id="@+id/filter_sensor" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"/>
    </LinearLayout>
</ScrollView>
