<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/card" android:foreground="?android:attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:background="@drawable/pen_stat_surface" android:src="@drawable/ic_pens" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/penName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="18sp" android:textStyle="bold" android:textColor="#183A2B"/>
        <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:id="@+id/reading" android:layout_width="24dp" android:layout_height="40dp" android:gravity="center" android:layout_marginStart="6dp" android:textSize="24sp" android:textColor="#799084" android:importantForAccessibility="no"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#EDF1ED"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_devices" android:importantForAccessibility="no"/>
        <TextView android:layout_width="76dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Sensors" android:textColor="#6B8073" android:textSize="13sp"/>
        <TextView android:id="@+id/pen_sensor_summary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="13sp" android:textColor="#294B37"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="top">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_pen_camera" android:importantForAccessibility="no"/>
        <TextView android:layout_width="76dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Cameras" android:textColor="#6B8073" android:textSize="13sp"/>
        <TextView android:id="@+id/pen_camera_summary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="13sp" android:textColor="#294B37"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/bar" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
</LinearLayout>
