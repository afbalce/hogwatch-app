<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/filter_panel">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Resolve alert" android:textSize="22sp" android:textStyle="bold" android:textColor="#183A2B"/>
        <Button android:id="@+id/resolve_close" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="×" android:textSize="24sp" android:contentDescription="Close resolution" android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical" android:focusableInTouchMode="true">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="You are taking action on" android:textSize="13sp" android:textColor="#657B6E"/>
            <TextView android:id="@+id/resolve_subject" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="14dp" android:background="@drawable/pen_stat_surface" android:textColor="#183A2B" android:textStyle="bold" android:textSize="16sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="14dp" android:orientation="vertical" android:background="@drawable/pen_stat_surface">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pre-resolution checklist" android:textSize="14sp" android:textStyle="bold" android:textColor="#294B37"/>
                <CheckBox android:id="@+id/resolve_inspected" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Environment physically inspected" android:textSize="14sp" android:buttonTint="#205B3F"/>
                <CheckBox android:id="@+id/resolve_hardware" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Hardware / sensors functioning normally" android:textSize="14sp" android:buttonTint="#205B3F"/>
                <CheckBox android:id="@+id/resolve_stable" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Readings are stabilizing" android:textSize="14sp" android:buttonTint="#205B3F"/>
            </LinearLayout>
            <TextView style="@style/ProfileLabel" android:text="Action taken" android:labelFor="@+id/resolve_action"/>
            <Spinner android:id="@+id/resolve_action" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/action_surface" android:paddingHorizontal="12dp"/>
            <TextView style="@style/ProfileLabel" android:text="Incident report / Notes (optional)" android:labelFor="@+id/resolve_notes"/>
            <EditText android:id="@+id/resolve_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences" android:hint="Add details about what was done…" android:textSize="14sp" android:padding="14dp" android:background="@drawable/profile_field"/>
            <TextView android:id="@+id/resolve_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#AF4936" android:textSize="13sp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
        <Button android:id="@+id/resolve_cancel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Cancel" android:textAllCaps="false" android:background="@drawable/action_surface" android:stateListAnimator="@null"/>
        <Button android:id="@+id/resolve_confirm" android:layout_width="0dp" android:layout_weight="2" android:layout_height="52dp" android:layout_marginStart="10dp" android:text="Confirm resolution" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/action_primary" android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
