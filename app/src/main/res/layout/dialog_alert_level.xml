<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Level name" android:textSize="13sp" android:textColor="#294B37" android:labelFor="@+id/level_name" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/level_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:background="@drawable/card" android:padding="10dp" android:textSize="16sp" android:singleLine="true" android:inputType="textCapWords" android:hint=""/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Severity" android:textSize="13sp" android:textColor="#294B37" android:layout_marginTop="12dp" android:labelFor="@+id/severity"/>
<Spinner android:id="@+id/severity" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sensor target" android:textSize="13sp" android:textColor="#294B37" android:layout_marginTop="12dp" android:labelFor="@+id/sensor_target"/>
<Spinner android:id="@+id/sensor_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Temperature threshold (°C)" android:textSize="13sp" android:textColor="#294B37" android:labelFor="@+id/temp_limit" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/temp_limit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:background="@drawable/card" android:padding="10dp" android:textSize="16sp" android:singleLine="true" android:inputType="numberSigned|numberDecimal" android:hint=""/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ammonia threshold (ppm)" android:textSize="13sp" android:textColor="#294B37" android:labelFor="@+id/gas_limit" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/gas_limit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:background="@drawable/card" android:padding="10dp" android:textSize="16sp" android:singleLine="true" android:inputType="number" android:hint=""/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Camera target" android:textSize="13sp" android:textColor="#294B37" android:layout_marginTop="12dp" android:labelFor="@+id/camera_target"/>
<Spinner android:id="@+id/camera_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"/>
<Switch android:id="@+id/take_snapshot" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:text="Take snapshot" android:textStyle="bold" android:textColor="#213E30" android:switchPadding="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capture still images on trigger." android:textSize="13sp" android:textColor="#294B37" />
<Switch android:id="@+id/record_video" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:text="Start recording" android:textStyle="bold" android:textColor="#213E30" android:switchPadding="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capture video on trigger." android:textSize="13sp" android:textColor="#294B37" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Snapshot limit" android:textSize="13sp" android:textColor="#294B37" android:labelFor="@+id/shot_count" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/shot_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:background="@drawable/card" android:padding="10dp" android:textSize="16sp" android:singleLine="true" android:inputType="number" android:hint=""/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seconds between snapshots" android:textSize="13sp" android:textColor="#294B37" android:labelFor="@+id/shot_spacing" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/shot_spacing" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:background="@drawable/card" android:padding="10dp" android:textSize="16sp" android:singleLine="true" android:inputType="number" android:hint=""/>
</LinearLayout>
</ScrollView>
