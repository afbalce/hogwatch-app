<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginTop="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Manage connections" android:textSize="14sp" android:textStyle="bold" android:textColor="#183A2B"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Swipe left or right for more options" android:textSize="12sp" android:textColor="#587062" android:layout_marginTop="4dp" android:layout_marginBottom="6dp"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:fadeScrollbars="false" android:scrollbarStyle="insideInset"
        android:scrollbarSize="3dp" android:scrollbarThumbHorizontal="@drawable/shortcut_scroll_thumb"
        android:paddingBottom="0dp" android:overScrollMode="ifContentScrolls">
        <LinearLayout android:id="@+id/pen_shortcut_list" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="@drawable/chip" android:padding="3dp" android:orientation="horizontal"/>
    </HorizontalScrollView>
</LinearLayout>
