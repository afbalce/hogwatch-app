<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:focusable="true" android:clickable="true"
    android:background="?android:attr/selectableItemBackground">
    <ImageView android:id="@+id/nav_icon" android:layout_width="48dp" android:layout_height="26dp"
        android:padding="3dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/nav_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:gravity="center" android:textSize="12sp" android:importantForAccessibility="no"/>
</LinearLayout>
