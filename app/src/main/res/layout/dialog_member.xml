<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Full name" android:labelFor="@+id/member_name" android:layout_marginTop="12dp" android:textColor="#294B37"/><EditText android:id="@id/member_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapWords" android:singleLine="true" android:maxLength="100" android:background="@drawable/action_surface" android:padding="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email address" android:labelFor="@+id/member_email" android:layout_marginTop="12dp" android:textColor="#294B37"/><EditText android:id="@id/member_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textEmailAddress" android:singleLine="true" android:maxLength="100" android:background="@drawable/action_surface" android:padding="10dp"/>
