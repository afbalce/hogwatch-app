<merge xmlns:android="http://schemas.android.com/apk/res/android">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/card">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Security" android:textSize="20sp" android:textColor="#294B37" android:textStyle="bold" android:layout_marginBottom="6dp"/>
<Switch android:id="@+id/two_factor" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:text="Two-factor authentication" android:textStyle="bold" android:textColor="#213E30" android:switchPadding="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phone verification requires a connected account." android:textSize="13sp" android:textColor="#294B37" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Change password" android:textSize="17sp" android:textColor="#294B37" android:layout_marginTop="20dp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Current password" android:textSize="13sp" android:textColor="#294B37" android:labelFor="@+id/current_password" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/current_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:background="@drawable/card" android:padding="10dp" android:textSize="16sp" android:singleLine="true" android:inputType="textPassword" android:hint="Enter current password"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New password" android:textSize="13sp" android:textColor="#294B37" android:labelFor="@+id/new_password" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/new_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:background="@drawable/card" android:padding="10dp" android:textSize="16sp" android:singleLine="true" android:inputType="textPassword" android:hint="At least 8 characters"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confirm new password" android:textSize="13sp" android:textColor="#294B37" android:labelFor="@+id/confirm_password" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/confirm_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:background="@drawable/card" android:padding="10dp" android:textSize="16sp" android:singleLine="true" android:inputType="textPassword" android:hint="Re-enter new password"/>
<Button android:id="@+id/change_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:minHeight="48dp" android:background="@drawable/action_primary" android:stateListAnimator="@null" android:textAllCaps="false" android:textColor="#FFFFFF" android:text="Update password"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Password changes are available when an account service is connected." android:textSize="13sp" android:textColor="#294B37" android:layout_marginTop="8dp"/>
</LinearLayout>
</merge>
