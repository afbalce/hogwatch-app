    android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/greeting_background"
    android:clickable="false" android:focusable="false">
    <TextView android:id="@+id/dashboard_greeting" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="20sp" android:textStyle="bold" android:textColor="#12352A"/>
