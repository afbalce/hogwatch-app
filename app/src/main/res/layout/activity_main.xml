<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F5F7F5">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="#FFFFFF" android:gravity="center_vertical" android:paddingHorizontal="16dp">
<ImageButton android:id="@+id/menu_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_menu" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Open management menu"/>
<TextView android:id="@+id/app_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="HogWatch" android:textStyle="bold" android:textSize="21sp" android:textColor="#163E33" android:letterSpacing="-.04"/>
<ImageButton android:id="@+id/add" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_add" android:tint="#163E33" android:layout_marginEnd="8dp" android:contentDescription="Add to farm"/>
<ImageButton android:id="@+id/export_report" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_export_report" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Export report" android:tooltipText="Export report" android:visibility="gone"/>
<FrameLayout android:id="@+id/notification_container" android:layout_width="48dp" android:layout_height="48dp">
<ImageButton android:id="@+id/notifications" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_notification_bell" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Open notifications"/>
<TextView android:id="@+id/notification_badge" android:layout_width="wrap_content" android:layout_height="20dp" android:minWidth="20dp" android:layout_gravity="top|end" android:layout_marginTop="2dp" android:paddingHorizontal="4dp" android:gravity="center" android:background="@drawable/notification_badge" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" android:importantForAccessibility="no" android:clickable="false"/>
</FrameLayout></LinearLayout>
<ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:background="#F5F7F5"><LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingTop="3dp" android:paddingBottom="14dp" android:orientation="vertical"/></ScrollView>
<LinearLayout android:id="@+id/navigation" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:minHeight="72dp" android:gravity="center_vertical" android:baselineAligned="false" android:paddingVertical="4dp" android:orientation="horizontal"
    android:elevation="4dp" android:clipToOutline="true" android:background="@drawable/nav_dock"/>
</LinearLayout>


