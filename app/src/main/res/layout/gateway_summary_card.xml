<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/gateway_card_surface" android:foreground="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/gateway_summary_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#183A2B" android:textSize="19sp" android:textStyle="bold"/>
        <TextView android:id="@+id/gateway_summary_link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Details  ›" android:textColor="#287354" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/gateway_summary_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#657B6E" android:textSize="12sp"/>
    <LinearLayout android:padding="14dp" android:background="@drawable/pen_stat_surface" android:id="@+id/gateway_summary_graph" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/gateway_summary_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#657B6E" android:textSize="12sp"/>
</LinearLayout>


