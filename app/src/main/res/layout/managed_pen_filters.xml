<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:layout_marginBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical" android:background="@drawable/pen_search_surface">
            <EditText android:id="@+id/pen_query" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@null" android:paddingHorizontal="14dp" android:paddingVertical="12dp" android:hint="Search pens or devices" android:contentDescription="Search pens or devices" android:singleLine="true" android:imeOptions="actionSearch" android:textColor="#183A2B" android:textColorHint="#657B6E" android:textSize="14sp"/>
            <Button android:id="@+id/clear_pen_search" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="×" android:textSize="22sp" android:textColor="#587062" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Clear search"/>
        </LinearLayout>
        <Button android:id="@+id/status_filter" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginStart="8dp" android:minWidth="76dp" android:paddingHorizontal="12dp" android:text="Filters" android:textAllCaps="false" android:textSize="13sp" android:textColor="#205B3F" android:background="@drawable/action_surface" android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>

