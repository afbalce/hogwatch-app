<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/card" android:foreground="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/device_card_icon" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:background="@drawable/pen_stat_surface" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/device_card_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="17sp" android:textStyle="bold" android:textColor="#183A2B"/>
        <TextView android:id="@+id/device_card_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="7dp" android:background="@drawable/pen_stat_surface" android:textSize="11sp" android:textColor="#587062"/>
        <TextView android:layout_width="24dp" android:layout_height="40dp" android:gravity="center" android:text="›" android:textSize="24sp" android:textColor="#799084"/>
    </LinearLayout>
    <TextView android:id="@+id/device_card_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="12sp" android:textColor="#657B6E"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#EDF1ED"/>
    <TextView android:id="@+id/device_card_assignment" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#294B37"/>
    <TextView android:id="@+id/device_card_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="12sp" android:textColor="#657B6E"/>
</LinearLayout>
