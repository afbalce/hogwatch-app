<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:layout_marginBottom="10dp" android:orientation="vertical">
    <TextView android:id="@+id/selection_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#607267" android:layout_marginBottom="6dp"/>
    <Button android:id="@+id/selection_value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:paddingHorizontal="14dp" android:paddingVertical="10dp"
        android:gravity="start|center_vertical" android:background="@drawable/action_surface" android:stateListAnimator="@null"
        android:drawableEnd="@drawable/ic_chevron_down" android:drawablePadding="12dp" android:textAllCaps="false"
        android:textSize="15sp" android:fontFamily="sans-serif" android:textColor="#234334"/>
</LinearLayout>
