<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="vertical">
    <TextView android:id="@+id/field_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#294B37"/>
    <EditText android:id="@+id/field_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="5dp" android:singleLine="true" android:maxLength="120" android:padding="12dp" android:background="@drawable/action_surface" android:textSize="16sp"/>
</LinearLayout>
